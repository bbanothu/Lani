{
  "expo": {
    "name": "Lani",
    "slug": "lani",
    "owner": "bbanothu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-store.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brainrotslop.lani",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Lani uses your photo library so you can choose a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e12f5543-6974-4944-b751-423c2bd086b8"
      }
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Lani to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Lani to use speech recognition for voice input."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lani uses your photo library so you can choose a profile picture."
        }
      ]
    ]
  }
}
