{
  "manifest_version": 3,
  "name": "Lani",
  "version": "0.1.0",
  "description": "Save products locally and chat with your chosen AI model",
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://localhost:3001/*", "https://lani.brainrotslop.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost:3001/*", "https://lani.brainrotslop.com/*"],
      "js": ["detect.js"],
      "run_at": "document_idle"
    }
  ]
}
